# Nyaya SETU — environment variables
# Copy this file to .env and fill in your own values. Never commit .env.

# --- Frontend (Vite) ---
# Supabase project (used for optional auth & saved history)
VITE_SUPABASE_URL="https://YOUR_PROJECT.supabase.co"
VITE_SUPABASE_PUBLISHABLE_KEY="YOUR_SUPABASE_ANON_KEY"

# Optional: custom backend URL. Defaults to the same origin (Netlify functions).
VITE_API_URL=""

# --- Netlify serverless functions (AI) ---
# Get a free key at https://aistudio.google.com/apikey
GEMINI_API_KEY="YOUR_GEMINI_API_KEY"
